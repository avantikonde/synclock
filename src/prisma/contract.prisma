// use prisma-8

enum EventStatus {
  POLLING
  ACTIVE
  COMPLETED
  CANCELLED
}

model Event {
  id            String       @id @default(uuid())
  title         String
  description   String?
  slug          String       @unique
  hostKey       String?      @unique
  duration      Int
  startDate     DateTime
  endDate       DateTime
  startHour     Int
  endHour       Int
  status        EventStatus  @default("POLLING")
  inviteeLimit  Int
  location      String
  hostName      String

}

model Participant {
  id        Int          @id @default(uuid())
  name      String
  email     String?      @unique
  eventId   String
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

}

